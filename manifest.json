{
    "manifest_version" : 3,
    "name" : "chrome-extension-stress-reducer",
    "version" : "1.0",
    "description": "Reduce stress during web browsing for individuals with neurodivergent conditions and cognitive disabilities",

    "background": {
        "service_worker": "service_workers/background.js"
    },

    "action": {
        "default_icon": {
        "16": "images/toggle_on-16.svg",
        "32": "images/toggle_on-32.svg"
        },
        "default_title": "Toggle Stress Reducer"
    },

    "declarative_net_request": {
        "rule_resources": [
        {
            "id": "ruleset_1",
            "enabled": true,
            "path": "ad_filters/block_rules.json"
        }
        ]
    },
    
    "permissions": [
        "declarativeNetRequest",
        "storage",
        "scripting",
        "activeTab"
    ],

    "content_scripts": [
        {
            "matches": [
                "https://*/*"
            ],
            "js": [
                "libs/utils.js",
                "libs/compromise.js",
                "libs/summary_minified.js",
                "scripts/layout-simplifier.js",
                "scripts/highlighter.js",
                "scripts/summarizer.js",
                "scripts/navigation-simplifier.js",
                "scripts/floating-menu.js"
            ]
        }
    ],

    "web_accessible_resources": [
        {
            "resources": [
                "images/*"
            ],
            "matches": [
                "https://*/*"
            ]
        }
    ]

}